# AI Film Studio Environment Configuration Template

# System
APP_NAME="AI Film Studio"
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000

# Device & Worker Role (CONTROL_NODE, WORKER_NODE, STORAGE_NODE)
DEVICE_ID=node-primary
DEVICE_ROLE=CONTROL_NODE

# Storage Paths
STORAGE_ROOT=./storage
PROJECTS_ROOT=./projects

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_film_studio

# Redis & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Tool Paths (Leave empty to use system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
BLENDER_PATH=

# Model Hub API Keys (Configured per provider as needed)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
KLING_API_KEY=
RUNWAY_API_KEY=
